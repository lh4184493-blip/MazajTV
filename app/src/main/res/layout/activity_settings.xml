<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:padding="20dp">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/settingsToolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/background"
        app:titleTextColor="@color/gold"
        app:title="@string/settings"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/playlistLabel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="@string/playlist_url_label"
        android:textColor="@color/text_primary"
        android:textSize="16sp"
        app:layout_constraintTop_toBottomOf="@id/settingsToolbar" />

    <EditText
        android:id="@+id/playlistUrlInput"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:background="@drawable/card_background"
        android:hint="@string/playlist_url_hint"
        android:textColorHint="@color/text_secondary"
        android:textColor="@color/text_primary"
        android:padding="14dp"
        android:inputType="textUri"
        app:layout_constraintTop_toBottomOf="@id/playlistLabel" />

    <Button
        android:id="@+id/saveButton"
        style="@style/Widget.MaterialComponents.Button"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/save"
        android:textColor="@color/background"
        android:backgroundTint="@color/gold"
        app:layout_constraintTop_toBottomOf="@id/playlistUrlInput" />

    <Button
        android:id="@+id/resetButton"
        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/reset_default"
        android:textColor="@color/gold"
        app:strokeColor="@color/gold"
        app:layout_constraintTop_toBottomOf="@id/saveButton" />

</androidx.constraintlayout.widget.ConstraintLayout>
